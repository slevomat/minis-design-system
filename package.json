{
  "name": "@minis/design-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter \"./packages/**\" dev",
    "build": "pnpm --filter \"./packages/**\" build",
    "storybook": "pnpm --filter storybook storybook",
    "build-storybook": "pnpm --filter storybook build-storybook",
    "test": "pnpm --filter \"./packages/**\" test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,css,md}\"",
    "lint": "eslint \"**/*.{ts,tsx,js,jsx}\"",
    "create-prototype": "node packages/create-minis/bin/create.js",
    "figma:publish": "figma connect publish --token=$FIGMA_ACCESS_TOKEN",
    "figma:unpublish": "figma connect unpublish --token=$FIGMA_ACCESS_TOKEN",
    "figma:parse": "figma connect parse --token=$FIGMA_ACCESS_TOKEN"
  },
  "devDependencies": {
    "@figma/code-connect": "^1.4.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  }
}
